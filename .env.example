# Secret used to verify GitHub webhook signatures (X-Hub-Signature-256)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Anthropic API key for the triage agent
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# GitHub personal access token (needs 'repo' scope for private repos, or just public_repo)
GITHUB_TOKEN=your-github-token-here

# Base URL for the GitHub API (default: https://api.github.com)
# Override for GitHub Enterprise Server
# GITHUB_API_BASE=https://github.example.com/api/v3

# ---------------------------------------------------------------------------
# Bitbucket (only needed if using the Bitbucket webhook)
# ---------------------------------------------------------------------------

# Secret used to verify Bitbucket webhook signatures (X-Hub-Signature)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# BITBUCKET_WEBHOOK_SECRET=your-bitbucket-webhook-secret-here

# Bitbucket username and app password for API authentication
# Create an app password at: Bitbucket → Personal settings → App passwords
# Required scopes: Repositories (read), Pull requests (read + write)
# BITBUCKET_USERNAME=your-bitbucket-username
# BITBUCKET_APP_PASSWORD=your-bitbucket-app-password

# Base URL for the Bitbucket API (default: https://api.bitbucket.org/2.0)
# BITBUCKET_API_BASE=https://api.bitbucket.org/2.0

# ---------------------------------------------------------------------------
# Reviewer persona for the general review agent (default: senior-dev)
REVIEWER_ROLE=senior-dev

# ngrok static domain for the webhook tunnel (free-tier static URL)
NGROK_URL=your-ngrok-static-domain-here

# Logfire observability — write token for the pr-review-agent project
# Generate at: logfire.pydantic.dev → project → Settings → Write tokens
# Leave unset to disable tracing (app runs normally without it)
# LOGFIRE_TOKEN=your-write-token-here
